<!--
  TDesign TDesign Miniprogram 示例：cascader - index
  覆盖组件：Cascader
  来源：组件库源码 packages/components/cascader/_example/index.wxml
-->

<t-cell title="地址" note="{{note}}" bind:click="showCascader" arrow />

<t-cascader
  visible="{{visible}}"
  value="{{value}}"
  options="{{options}}"
  title="请选择地址"
  filterable
  filter-placeholder="搜索省/市/区"
  bind:change="onChange"
  bind:pick="onPick"
/>
