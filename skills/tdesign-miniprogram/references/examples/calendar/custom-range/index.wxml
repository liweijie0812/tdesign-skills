<!--
  TDesign TDesign Miniprogram 示例：calendar - index
  覆盖组件：Calendar
  来源：组件库源码 packages/components/calendar/_example/index.wxml
-->

<wxs src="../calendar.wxs" module="_this" />

<t-calendar
  visible="{{visible}}"
  value="{{value}}"
  minDate="{{minDate}}"
  maxDate="{{maxDate}}"
  bind:confirm="handleConfirm"
/>
<t-cell arrow title="含不可选的日历" note="{{_this.formatTimestamp(value)}}" bind:tap="handleCalendar" />
