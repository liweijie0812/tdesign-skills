<!--
  TDesign TDesign Miniprogram 示例：date-time-picker - index
  覆盖组件：Date-time-picker
  来源：组件库源码 packages/components/date-time-picker/_example/index.wxml
-->

<t-cell
  title="选择日期"
  hover
  note="{{dateText || ''}}"
  arrow
  data-mode="date"
  bindtap="showPicker"
  class="test"
  t-class="panel-item"
/>

<!-- 年月日 -->
<t-date-time-picker
  auto-close
  title="选择日期"
  showWeek
  visible="{{dateVisible}}"
  mode="date"
  default-value="{{date}}"
  format="YYYY-MM-DD ddd"
  filter="{{filter}}"
  formatter="{{formatter}}"
  popup-props="{{popupProps}}"
  bindchange="onConfirm"
  bindpick="onColumnChange"
  bindcancel="hidePicker"
  bindclose="handleClose"
/>
