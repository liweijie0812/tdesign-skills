<!--
  TDesign TDesign Miniprogram 示例：upload - index
  覆盖组件：Upload
  来源：组件库源码 packages/components/upload/_example/index.wxml
-->

<view class="wrapper">
  <t-upload
    disabled
    mediaType="{{['video','image']}}"
    files="{{originFiles}}"
    gridConfig="{{gridConfig}}"
    config="{{config}}"
    source="messageFile"
    bind:success="handleSuccess"
    bind:remove="handleRemove"
  >
  </t-upload>
</view>
