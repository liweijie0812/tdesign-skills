<!--
  TDesign TDesign Miniprogram 示例：indexes - index
  覆盖组件：Indexes
  来源：组件库源码 packages/components/indexes/_example/index.wxml
-->

<view class="custom-navbar">
  <t-navbar title="TDesign" leftArrow placeholder />
</view>
<t-indexes
  current="{{current}}"
  index-list="{{indexList}}"
  sticky-offset="{{stickyOffset}}"
  bind:select="onSelect"
  bind:change="onChange"
>
  <block wx:for="{{list}}" wx:key="index">
    <t-indexes-anchor index="{{item.index}}" />
    <t-cell-group>
      <t-cell wx:for="{{item.children}}" wx:key="city" wx:for-item="city" title="{{city}}" aria-role="button" />
    </t-cell-group>
  </block>
</t-indexes>
