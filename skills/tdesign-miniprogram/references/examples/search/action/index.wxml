<!--
  TDesign TDesign Miniprogram 示例：search - index
  覆盖组件：Search
  来源：组件库源码 packages/components/search/_example/index.wxml
-->

<view class="example-search">
  <t-search
    value="{{value}}"
    center
    placeholder="搜索预设文案"
    action="{{actionText}}"
    bind:blur="blurHandle"
    bind:focus="focusHandle"
    bind:action-click="actionHandle"
    bind:change="changeHandle"
  />
</view>
