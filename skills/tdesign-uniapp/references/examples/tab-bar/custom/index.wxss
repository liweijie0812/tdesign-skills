.wrapper {
  --td-tab-bar-border-color: var(--td-border-level-1-color, #e7e7e7);
  --td-tab-bar-bg-color: var(--td-bg-color-secondarycontainer, #f3f3f3);
  --td-tab-bar-hover-color: #ddd;
