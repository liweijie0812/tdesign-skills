<view class="wrapper">
  <t-upload
    disabled
    mediaType="{{['video','image']}}"
    max="{{1}}"
    files="{{fileList}}"
    bind:add="handleAdd"
    bind:remove="handleRemove"
  >
  </t-upload>
</view>
