<!--
  TDesign TDesign UniApp 示例：drawer - index
  覆盖组件：Drawer
  来源：组件库源码 packages/components/drawer/_example/index.vue
-->

<t-button variant="outline" bind:tap="openDrawerBase" block size="large" theme="primary">带底部插槽</t-button>

<t-drawer
  visible="{{visible}}"
  placement="{{placement}}"
  title="标题"
  items="{{sidebar}}"
  usingCustomNavbar
  bind:overlay-click="overlayClick"
  bind:item-click="itemClick"
>
  <view class="button-host">
    <t-button slot="footer" size="large=" block variant="outline">操作</t-button>
  </view>
</t-drawer>
